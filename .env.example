# Copia este archivo como .env (nunca subas .env a GitHub)

# --- App web ---
SECRET_KEY=pon-aqui-una-cadena-larga-y-aleatoria
# 1 = carga usuarios y datos de demostración la primera vez (para la presentación). Con datos reales: 0
SEED_DEMO=1
DEMO_PASSWORD=datalife2026

# --- Base de datos (Render o Neon te dan esta URL) ---
# DATABASE_URL=postgresql://usuario:clave@host:5432/datalife

# --- ETL desde Google Sheets ---
# ID de la hoja: lo que va entre /d/ y /edit en la URL de la hoja
GOOGLE_SHEET_ID=
# JSON completo de la cuenta de servicio (en una sola línea) o la ruta al archivo .json
GOOGLE_SERVICE_ACCOUNT_JSON=
# Token secreto que Apps Script envía para disparar el ETL al instante
ETL_WEBHOOK_TOKEN=
